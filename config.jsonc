{
    "layer":"top",
    "height": 32,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    // "margin-bottom": -5,


    "modules-left":["clock", "wireplumber", "backlight/slider", "tray"],
    "modules-center":["hyprland/window"],
    "modules-right":["network", "cpu",  "battery"],
    // "modules-right":["network", "bluetooth", "custom/wlogout", "battery"],


    "clock":{
        "format":"[ {:%a, %b %d - %I:%M %p} ] "
    },

    "wireplumber":{
        "format": " [  : {volume}% ] ",
        "on-click": "pavucontrol"
    },

    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "hyprland/window": {
        "format": "[ {title} ]",
        "max-length": 80,
    },

    "battery": {
        "format": " [ {icon}: {capacity}% - {time}]",
        "format-icons": ["", "", "", "", ""],
        "format-time": "{H}h{M}m",
        "format-charging": " {capacity}% - {time}",
        "format-full": "  Charged",
        "interval": 5,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "tooltip": false,
        "on-click": "alacritty -e battop"
    },

    "network": {
        "interface": "*0",
        "format-ethernet": " [  : {essid} ] ",
        "format-wifi": " [ {icon}: {essid} ] ",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-disconnected": " [ 󰤭 : OFFLINE ] ",
        "max-length": 10,
        "on-click": "kitty  nmtui"
    },

    "bluetooth": {
        "format": " [ : {device_alias} - {device_battery_percentage}% ] ",
        "format-on": " [ : ACTIVE ] ",
        "format-off": " [ : INACTIVE ] ",
        "on-click": "alacritty -e bluetoothctl"
    },

    "cpu": {
        "format": "{usage}% - {avg_frequency} GHz",
        "on-click": "alacritty -e htop",
        "on-click-right": "alacritty -e nvtop"
    },
    
    "custom/wlogout": {
        "format": " [󰘧] ",
        "interval": "once",
        "on-click": "poweroff"
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "icons": {}
    }
}
